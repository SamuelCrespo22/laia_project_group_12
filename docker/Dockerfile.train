
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install training dependencies
COPY docker/requirements-training.txt /app/requirements-training.txt

RUN pip install --no-cache-dir \
    -r /app/requirements-training.txt

# Copy project source code and configuration
COPY src/ /app/src/
COPY configs/ /app/configs/

# Create directories for data, models and reports
RUN mkdir -p /app/data /app/models /app/reports

# Create a non-root user
RUN useradd --create-home --uid 10001 trainer \
    && chown -R trainer:trainer /app

USER trainer

# MLflow tracking server address is provided at runtime
ENV MLFLOW_TRACKING_URI=http://mlflow:5000

# Training entrypoint
CMD ["python", "-m", "src.models.train"]
